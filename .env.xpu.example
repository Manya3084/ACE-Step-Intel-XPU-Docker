# =============================================================================
# ACE-Step 1.5 — Sample .env optimized for Intel Arc A770 16GB
# =============================================================================
#
# Usage:
#   cp .env.xpu.example .env
#   mkdir -p datasets/uploads lora_output checkpoints
#
# =============================================================================

# ==================== Mode ====================
# gradio-api = Gradio + --enable-api on 8001 (required by ace-step-ui)
ACESTEP_MODE=gradio-api

# ==================== Model Settings ====================
# DiT (music decoder). Default 2B turbo is safest on 16GB with CPU offload.
# XL (4B) is selectable in Create advanced options / Gradio model dropdown:
#   acestep-v15-xl-turbo  |  acestep-v15-xl-sft  |  acestep-v15-xl-base
# First select downloads ~9GB weights into ./checkpoints; needs offload on A770.
# LoRAs trained on 2B turbo are NOT compatible with XL (and vice versa).
ACESTEP_CONFIG_PATH=acestep-v15-turbo
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-1.7B
ACESTEP_DEVICE=xpu
ACESTEP_LM_BACKEND=pt
ACESTEP_LLM_BACKEND=pt

# ==================== LLM Initialization ====================
ACESTEP_INIT_LLM=true
ACESTEP_INIT_SERVICE=true
ACESTEP_OFFLOAD_TO_CPU=true
ACESTEP_OFFLOAD_DIT_TO_CPU=true

# --- LM system-RAM path (A770 16GB + large host RAM, e.g. 128GB) ---
# Keep 5Hz LM weights on CPU; shuttle to XPU only during CoT/codes.
# Also used by pure-API lazy init (llm_readiness).
ACESTEP_LM_OFFLOAD_TO_CPU=true
# Allow acestep-5Hz-lm-4B on tier6a (~16GB). Upstream otherwise force-downgrades to 1.7B.
ACESTEP_ALLOW_4B_LM=true
# Optional: force full-CPU LM (slowest, almost no LM VRAM). Uncomment to try:
# ACESTEP_LM_DEVICE=cpu
# ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-4B
# Recommended trial combo: turbo DiT + 4B LM (not XL+4B on first try).

# Optional stability on Arc if you see NaN latents:
# ACESTEP_DTYPE=float32

# LoRA load requires quantization disabled (PEFT cannot attach to int8 DiT).
# Passed through docker-entrypoint as extra CLI args.
ACESTEP_EXTRA_ARGS=--quantization none

# ==================== API / Gradio ====================
ACESTEP_API_HOST=0.0.0.0
ACESTEP_API_PORT=8001
GRADIO_SERVER_NAME=0.0.0.0

# ==================== Performance ====================
PYTORCH_DEVICE=xpu
TORCH_COMPILE_BACKEND=eager
SYCL_CACHE_PERSISTENT=1
SYCL_PI_LEVEL_ZERO_USE_IMMEDIATE_COMMANDLISTS=1
ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
TOKENIZERS_PARALLELISM=false
ACESTEP_BATCH_SIZE=1

# ==================== UI / Training paths ====================
# Host dirs (bind-mounted into BOTH acestep-ui and acestep-xpu):
#   ./datasets      -> /app/datasets
#   ./lora_output   -> /app/lora_output
#   ./checkpoints   -> /app/checkpoints
#
# Prefer 48 kHz stereo WAV for preprocess (soundfile backend; no torchcodec).
#
# In the Training tab use paths under /app/datasets/..., e.g.:
#   /app/datasets/my_lora_dataset.json
#   /app/datasets/uploads
#   /app/datasets/preprocessed_tensors
#   /app/lora_output

ENABLE_DOCKER_RESTART=true
XPU_CONTAINER_NAME=acestep-xpu
JWT_SECRET=ace-step-ui-local-secret-change-me
